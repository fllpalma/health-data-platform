# .env.example: template of the settings/secrets this project needs.
# Copy it:  cp .env.example .env   then put real values in .env (which Git ignores).
# This file IS committed, so it must only ever contain names and safe placeholders.
# Tip: generate a strong value with:  openssl rand -hex 16

# --- Phase 1: data lake (SeaweedFS, S3-compatible) ---------------
LAKE_ACCESS_KEY=change-me            # like an S3 "username"
LAKE_SECRET_KEY=change-me            # like an S3 "password"
LAKE_ADMIN_PASSWORD=change-me        # login for the browser Admin UI (user: admin)

# --- Phase 1: data warehouse (Postgres) ---------------------------
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me
POSTGRES_DB=health
