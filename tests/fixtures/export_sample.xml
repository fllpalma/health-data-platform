<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTHETIC test file. Same structure as an Apple Health export.xml, but every value is invented.
  Contains no real health data. Safe to commit.
-->
<!DOCTYPE HealthData [
<!ELEMENT HealthData (ExportDate,Me,(Record|Correlation|Workout|ActivitySummary)*)>
<!ATTLIST HealthData locale CDATA #REQUIRED>
]>
<HealthData locale="en_GB">
 <ExportDate value="2026-11-14 10:00:00 +0000"/>
 <Me HKCharacteristicTypeIdentifierDateOfBirth="1990-01-01" HKCharacteristicTypeIdentifierBiologicalSex="HKBiologicalSexNotSet"/>

 <!-- 1. Steps from the iPhone -->
 <Record type="HKQuantityTypeIdentifierStepCount" sourceName="Test iPhone" sourceVersion="18.0" device="&lt;&lt;HKDevice: 0x1&gt;, name:iPhone&gt;" unit="count" creationDate="2026-11-01 09:05:00 +0000" startDate="2026-11-01 09:00:00 +0000" endDate="2026-11-01 09:05:00 +0000" value="412"/>

 <!-- 2. Steps from the Watch, same time window. A known trap: iPhone + Watch double-count (dedupe is Phase 2's job) -->
 <Record type="HKQuantityTypeIdentifierStepCount" sourceName="Test Watch" sourceVersion="11.0" unit="count" creationDate="2026-11-01 09:06:00 +0000" startDate="2026-11-01 09:00:00 +0000" endDate="2026-11-01 09:05:00 +0000" value="398"/>

 <!-- 3. Heart rate with metadata (extra key/value details nested inside the record) -->
 <Record type="HKQuantityTypeIdentifierHeartRate" sourceName="Test Watch" sourceVersion="11.0" unit="count/min" creationDate="2026-11-01 09:10:00 +0000" startDate="2026-11-01 09:10:00 +0000" endDate="2026-11-01 09:10:00 +0000" value="64">
  <MetadataEntry key="HKMetadataKeyHeartRateMotionContext" value="1"/>
 </Record>

 <!-- 4. Sleep: a category, so the value is text, not a number -->
 <Record type="HKCategoryTypeIdentifierSleepAnalysis" sourceName="Test Watch" sourceVersion="11.0" creationDate="2026-11-02 07:00:00 +0000" startDate="2026-11-01 23:30:00 +0000" endDate="2026-11-02 06:45:00 +0000" value="HKCategoryValueSleepAnalysisAsleepCore"/>

 <!-- 5. Trap: blood pressure is a Correlation that WRAPS copies of records. Only top-level records count. -->
 <Correlation type="HKCorrelationTypeIdentifierBloodPressure" sourceName="Test Cuff" creationDate="2026-11-03 08:00:00 +0000" startDate="2026-11-03 08:00:00 +0000" endDate="2026-11-03 08:00:00 +0000">
  <Record type="HKQuantityTypeIdentifierBloodPressureSystolic" sourceName="Test Cuff" unit="mmHg" creationDate="2026-11-03 08:00:00 +0000" startDate="2026-11-03 08:00:00 +0000" endDate="2026-11-03 08:00:00 +0000" value="118"/>
 </Correlation>
 <Record type="HKQuantityTypeIdentifierBloodPressureSystolic" sourceName="Test Cuff" unit="mmHg" creationDate="2026-11-03 08:00:00 +0000" startDate="2026-11-03 08:00:00 +0000" endDate="2026-11-03 08:00:00 +0000" value="118"/>

 <!-- Not records: must be ignored by the record parser -->
 <Workout workoutActivityType="HKWorkoutActivityTypeRunning" duration="30" durationUnit="min" sourceName="Test Watch" creationDate="2026-11-04 18:31:00 +0000" startDate="2026-11-04 18:00:00 +0000" endDate="2026-11-04 18:30:00 +0000"/>
 <ActivitySummary dateComponents="2026-11-04" activeEnergyBurned="500" activeEnergyBurnedGoal="600" activeEnergyBurnedUnit="kcal"/>
</HealthData>
