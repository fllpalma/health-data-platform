# sqlfluff: SQL style checker (like ruff, for SQL)
[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 120
# ST06: keep columns in human order (date first, then metrics) rather than sqlfluff's order
# RF04: names like "value" come from Apple's data
exclude_rules = ST06, RF04

[sqlfluff:templater:jinja]
# understand dbt's ref() / source()
apply_dbt_builtins = True
# stand-ins for dbt.datediff / dbt.dateadd / dbt.type_numeric (lint only)
library_path = transform/sqlfluff_libs

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
